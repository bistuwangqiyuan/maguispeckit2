# Netlify Headers Configuration for SEO and Performance
# 最佳实践配置

/*
  # 安全头部
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  
  # HSTS (HTTP Strict Transport Security)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # 内容安全策略 (CSP)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://*.supabase.co; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none';
  
  # 缓存控制 - 默认1小时
  Cache-Control: public, max-age=3600, must-revalidate

# HTML 文件 - 不缓存，始终获取最新
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# 主页特殊处理
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Link: </css/main.css>; rel=preload; as=style
  Link: </js/app.js>; rel=preload; as=script

# CSS 文件 - 长期缓存
/css/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/css; charset=utf-8

# JavaScript 文件 - 长期缓存
/js/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8

# 图片文件 - 长期缓存
/images/*
  Cache-Control: public, max-age=31536000, immutable
  
# PNG
/*.png
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/png

# JPG
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/jpeg

# SVG
/*.svg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/svg+xml; charset=utf-8

# WebP
/*.webp
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/webp

# 字体文件 - 长期缓存
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.woff
  Content-Type: font/woff
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Content-Type: font/woff2
  Cache-Control: public, max-age=31536000, immutable

# Manifest 和配置文件
/manifest.json
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=utf-8

/browserconfig.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

# Sitemap 和 Robots
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

# Favicon
/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/x-icon

# Service Worker - 不缓存
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# 404 页面
/404.html
  Cache-Control: no-cache, no-store, must-revalidate

